@host = http://localhost:51996
@companyId = 0112e2ba-bb87-48c4-bcfb-99e8d964d01f

### 업체 생성
POST {{host}}/api/companies
Content-Type: application/json

{
  "name": "테스트 업체",
  "address": "서울특별시 강남구",
  "type": "PRODUCER",
  "hubId": "11111111-1111-1111-1111-111111111111"
}

### 업체 수정
PATCH {{host}}/api/companies/{{companyId}}
Content-Type: application/json

{
  "name": "수정된 업체명",
  "address": "서울특별시 서초구",
  "type": "PRODUCER",
  "hubId": "11111111-1111-1111-1111-111111111111"
}

### 업체 목록 조회 (페이징)
GET {{host}}/api/companies?page=0&size=10&sort=createdAt,desc
Content-Type: application/json